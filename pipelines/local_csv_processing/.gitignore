```gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyd
*.pyo
*.egg-info/
.eggs/

# Environments
.env
.venv/
venv/
env/
# virtualenv created in current directory
.direnv/

# Editor files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs and data
logs/*.log
data/output/

# Testing
.pytest_cache/
htmlcov/
.coverage

# Jupyter Notebook files
.ipynb_checkpoints/

# MyPy
.mypy_cache/

# Docker
.dockerignore

# Misc
*.bak
*.swp
*~
```