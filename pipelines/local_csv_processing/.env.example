```dotenv
# General logging level for the pipeline (e.g., INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# Path to the log file where pipeline execution details will be recorded
LOG_FILE_PATH=logs/pipeline.log

# --- Bronze Layer Configuration ---
# Path to the local CSV input file for the bronze layer ingestion
BRONZE_LOCAL_CSV_INPUT_PATH=data/input/transactions.csv

# --- Gold Layer Configuration ---
# Path to the local CSV file where the processed gold layer data will be saved
GOLD_OUTPUT_PATH=data/output/processed_transactions.csv
```