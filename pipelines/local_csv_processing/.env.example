```env
# General environment setting for the pipeline (e.g., development, production)
ENVIRONMENT=development

# Name of the pipeline instance
PIPELINE_NAME=local_csv_processing

# Log level for the pipeline (e.g., INFO, DEBUG, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Path to the input CSV folder for the bronze layer
BRONZE_INPUT_CSV_FOLDER_PATH=data/input_csv_folder

# Path where the gold layer output CSVs will be stored
GOLD_OUTPUT_FOLDER_PATH=data/gold_output
```