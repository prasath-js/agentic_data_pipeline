```dotenv
# Logging level for the pipeline (e.g., DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Directory path for the raw source files (input_folder)
INPUT_FOLDER_PATH=/path/to/your/input_folder

# Directory path to store the raw Bronze layer data
BRONZE_OUTPUT_PATH=/path/to/your/bronze_output_folder

# Directory path to store the cleaned, masked, and transformed Silver layer data
SILVER_OUTPUT_PATH=/path/to/your/silver_output_folder

# Directory path to store the aggregated and finalized Gold layer data
GOLD_OUTPUT_PATH=/path/to/your/gold_output_folder

# Optional: SQLAlchemy Database URI for metadata tracking or future relational targets
DATABASE_URL=sqlite:////path/to/your/local_database.db
```