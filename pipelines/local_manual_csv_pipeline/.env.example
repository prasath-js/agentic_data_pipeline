```dotenv
# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Local File Source Configuration (Bronze Layer)
# Path to the directory containing input_folder local files
INPUT_FOLDER_PATH=/path/to/your/input_folder

# Local File Output Configuration (Gold Layer)
# Path to the directory where the gold local files will be written
OUTPUT_FOLDER_PATH=/path/to/your/output_folder

# Database Connection (SQLAlchemy fallback/metadata)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=secret
DB_NAME=pipeline_db
```